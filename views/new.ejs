<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>New Chat</title>
</head>
<body class="newmsg">
    <h1>Write a new chat</h1>
    <form action="/chats" method="post">
        <input type="text" placeholder="Write the sender name" name="from"> <br><br>
        <textarea name="msg" id="" placeholder="Enter Your Massage Here" rows="5"></textarea> <br> <br>
        <input type="text" placeholder="Write the receiver Name" name="to"><br><br>
        <button>Create a chat</button>
    </form>
</body>
</html>